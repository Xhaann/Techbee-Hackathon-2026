APP_NAME=Network Incident Diagnosis Assistant
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AI_API_KEY=
OPENAI_API_KEY=
FOUNDRY_API_KEY=
AI_PROVIDER=disabled
AI_MODEL=
AI_ENDPOINT=
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=2000
AI_TEMPERATURE=
INCIDENT_STORE_DIR=
# Seed the ten SCN synthetic scenarios as demo incidents at startup; existing records are never changed.
DEMO_INCIDENTS=true
CONVERSATION_STORE_DIR=var/conversations
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_REQUESTS=32
AUTH_TOKENS_FILE=var/auth/tokens.json
MAX_CONCURRENT_AGENT_RUNS=4
AUTH_USERS_FILE=var/auth/users.json
SESSION_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=300
MODEL_RUN_SECONDS=120
TELEMETRY_SIMULATION=true
TELEMETRY_INTERVAL_SECONDS=5
TELEMETRY_MAX_SERIES=2000
TELEMETRY_POINTS_PER_SERIES=720
TELEMETRY_MAX_EVENTS=5000
TELEMETRY_MAX_FLOWS=20000
TELEMETRY_STREAM_MAX_SECONDS=300
TELEMETRY_MAX_STREAMS=8
TELEMETRY_MAX_STREAMS_PER_PRINCIPAL=2
TELEMETRY_SYSLOG_UDP_PORT=0
TELEMETRY_FLOW_UDP_PORT=0
TELEMETRY_UDP_HOST=127.0.0.1
TELEMETRY_UDP_ALLOW_REMOTE=false
TELEMETRY_UDP_MAX_DATAGRAMS_PER_SECOND=500
